# Valores de ejemplo para local; no usar en el equipo de despliegue.
# Todos son ficticios. Para cambiarlos, crear un .env (Git lo ignora) con las variables a reemplazar.

# Superusuario de PostgreSQL y base del MDD.
POSTGRES_PASSWORD=cambiar-en-local-postgres
POSTGRES_DB=mdd

# Clave del rol de cada proceso (deploy/postgres/01-esquemas.sh y application.yaml de cada proceso).
DB_CLAVE_IDENTIDAD=cambiar-en-local-identidad
DB_CLAVE_DATOS=cambiar-en-local-datos
DB_CLAVE_DISTRIBUTIVO=cambiar-en-local-distributivo
DB_CLAVE_SALIDA=cambiar-en-local-salida

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mdd

# Cada JVM se dimensiona con el límite de memoria de su contenedor (ADR-008, R-19).
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60
