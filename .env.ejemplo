# Valores de ejemplo para local; no usar en el equipo de despliegue.
# Todos son ficticios. Para cambiarlos, crear un .env (Git lo ignora) con las variables a reemplazar.

# Superusuario de PostgreSQL y base del MDD.
POSTGRES_PASSWORD=cambiar-en-local-postgres
POSTGRES_DB=mdd

# Clave del rol de cada proceso (deploy/postgres/01-esquemas.sh y application.yaml de cada proceso).
DB_CLAVE_IDENTIDAD=cambiar-en-local-identidad
DB_CLAVE_DATOS=cambiar-en-local-datos
DB_CLAVE_DISTRIBUTIVO=cambiar-en-local-distributivo
DB_CLAVE_SALIDA=cambiar-en-local-salida

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mdd

# Usuario de prueba autor.prueba; solo para local (research §8 de B00-H03).
MDD_USUARIO_PRUEBA_HABILITADO=true
MDD_USUARIO_PRUEBA_CLAVE=cambiar-en-local-usuario-prueba

# Clave común de los 11 usuarios de la demo (docente.demo, vicerrectorado.demo…); solo para local
# y la CI. En el equipo de demostración cada uno tiene la suya en secretos/claves-demo (D-59).
MDD_USUARIOS_DEMO_CLAVE=cambiar-en-local-demo

# Clave del proceso distributivo para pedir su token de proceso a Usuarios: la usan identidad y
# distributivo (D-49, ADR-018).
MDD_CLAVE_PROCESO_DISTRIBUTIVO=cambiar-en-local-proceso-distributivo

# Clave del proceso datos, para que Académico avise a Roles de cada periodo y para que Académico,
# Docentes y Normativa registren sus cambios en la bitácora: la usan identidad y datos (F05-H03,
# F17-H01, ADR-018).
MDD_CLAVE_PROCESO_DATOS=cambiar-en-local-proceso-datos
# Clave del proceso salida, para que Reporting lea Aprobación y Generación y registre cada descarga
# en la bitácora: la usan identidad y salida (F20-H01, D-115, ADR-023).
MDD_CLAVE_PROCESO_SALIDA=cambiar-en-local-proceso-salida

# API Gateway al que la SPA envía /api (deploy/docker/frontend.Dockerfile, D-52).
MDD_URI_GATEWAY=http://gateway:8080

# Cada JVM se dimensiona con el límite de memoria de su contenedor (ADR-008, R-19).
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60

# F14-H03 (ADR-017): para firmar la cadena con el certificado real del autor en su perfil local,
# su nombre tal como está en el CN del certificado va en el .env local, nunca aquí:
# MDD_FIRMA_NOMBRE_LOCAL=
