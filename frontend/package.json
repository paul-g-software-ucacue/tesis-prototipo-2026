{
  "name": "mdd-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SPA del MDD (B00-H06, ADR-019): React con TypeScript, cliente generado desde contratos/.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generar:api": "openapi-typescript ../contratos/usuarios/openapi.yaml --output src/api/generado/usuarios.d.ts",
    "predev": "npm run generar:api",
    "dev": "vite",
    "prebuild": "npm run generar:api",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "pretipos": "npm run generar:api",
    "tipos": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.pruebas.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "formato": "prettier --write .",
    "formato:verificar": "prettier --check .",
    "pretest": "npm run generar:api",
    "test": "vitest",
    "test:e2e": "playwright test",
    "verificar:ruptura": "node scripts/verificar-ruptura.mjs",
    "sbom": "cyclonedx-npm --omit dev --output-file sbom-frontend.json"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@mui/material": "9.4.0",
    "@tanstack/react-query": "5.104.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "libxmljs2": false
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
