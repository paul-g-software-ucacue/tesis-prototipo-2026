# Despliegue automático del equipo de demostración (B00-H08, D-55): consulta Docker Hub y, si hay una
# versión nueva de main, la despliega con vuelta atrás e informa a GitHub (D-56). Lo dispara
# mdd-actualizar.timer cada 5 minutos; preparar.sh lo instala en /etc/systemd/system/.
[Unit]
Description=MDD: actualizar el equipo de demostración desde Docker Hub
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=mdd
Group=mdd
WorkingDirectory=/opt/mdd
Environment=RAIZ=/opt/mdd
# flock: dos consultas nunca despliegan a la vez.
ExecStart=/usr/bin/flock -n /opt/mdd/estado/candado /opt/mdd/bin/actualizar.sh
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
