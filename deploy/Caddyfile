# Proxy del VPS: HTTPS automático y acceso restringido (contrato de confidencialidad).
# La SPA pide usuario y contraseña; /api queda protegida por el JWT del MDD,
# porque el cliente usa la cabecera Authorization para el token.
{$DOMINIO} {
	@spa not path /api/*
	basic_auth @spa {
		{$DEMO_USUARIO} {$DEMO_CLAVE_HASH}
	}

	handle /api/* {
		reverse_proxy gateway:8080
	}
	handle {
		reverse_proxy frontend:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
